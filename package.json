{
  "name": "pipit-notes",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "icons": "node tools/make-icons.mjs",
    "diag": "node tools/diag-report.mjs",
    "check": "npm test && npm run build",
    "preview:ipad": "node node_modules/vite/bin/vite.js preview --host",
    "eval:exam": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-exam-eval.ps1",
    "tune:exam": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-exam-eval.ps1 tools/exam-tune.mjs",
    "tune:apply": "node tools/exam-tune-apply.mjs",
    "tune:review": "node tools/tune-review-build.mjs",
    "eval:check": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-exam-eval.ps1 tools/exam-check-test.mjs",
    "eval:cases": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-exam-eval.ps1 tools/exam-cases-test.mjs",
    "eval:diagrams": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-exam-eval.ps1 tools/diagram-test.mjs",
    "eval:ab": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-exam-eval.ps1 tools/exam-ab.mjs",
    "tune:auto": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-exam-eval.ps1 tools/exam-tune.mjs --auto --resume latest",
    "deploy:test": "npm run check && node ../Pipit/node_modules/netlify-cli/bin/run.js deploy --no-build --site bc0e3907-d774-4ffd-9bee-c1c65dd81e2f --dir=dist --functions=netlify/functions",
    "deploy:prod": "npm run check && node ../Pipit/node_modules/netlify-cli/bin/run.js deploy --prod --no-build --site bc0e3907-d774-4ffd-9bee-c1c65dd81e2f --dir=dist --functions=netlify/functions"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@netlify/blobs": "^11.1.6",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.61.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
